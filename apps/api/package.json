{
  "name": "@demanity/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "moderator:grant": "node --env-file=../../.env scripts/grant-moderator.mjs grant",
    "moderator:revoke": "node --env-file=../../.env scripts/grant-moderator.mjs revoke"
  },
  "dependencies": {
    "@demanity/db": "workspace:*",
    "@fastify/rate-limit": "^11.2.2",
    "@simplewebauthn/server": "^14.1.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
