# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# --- Local databases (infra/docker-compose.yml) ---
ACTIVITY_DATABASE_URL=postgres://demanity:dev-only-activity@127.0.0.1:5432/demanity_activity
VAULT_DATABASE_URL=postgres://vault:dev-only-vault@127.0.0.1:5433/demanity_vault
REDIS_URL=redis://127.0.0.1:6379

# --- Data APIs (Phase 3) ---
# One api.data.gov key covers Congress.gov, Regulations.gov and OpenFEC: https://api.data.gov/signup/
DATA_GOV_API_KEY=
# https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=
# https://www.courtlistener.com/sign-in/
COURTLISTENER_API_TOKEN=

# --- Verification (Phase 1) ---
SHEERID_ACCESS_TOKEN=
SHEERID_PROGRAM_ID=
