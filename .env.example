# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# --- Local databases (infra/docker-compose.yml) ---
ACTIVITY_DATABASE_URL=postgres://demanity:dev-only-activity@127.0.0.1:5434/demanity_activity
VAULT_DATABASE_URL=postgres://vault:dev-only-vault@127.0.0.1:5433/demanity_vault
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets: generate each with `node scripts/gen-secrets.mjs` (never reuse across environments) ---
# 32-byte base64 secret for hashing rate-limit keys (IPs are never stored raw)
RATE_LIMIT_SECRET=
# Shared token the API uses to call the vault (>= 32 chars)
VAULT_SERVICE_TOKEN=

# --- Passkeys (WebAuthn) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081

# --- Identity vault (apps/vault); internal only, never expose publicly ---
VAULT_URL=http://127.0.0.1:3100
VAULT_HOST=127.0.0.1
VAULT_PORT=3100
# "<version>:<32-byte base64>" list; highest version is current. Add a new version to rotate.
VAULT_TOKEN_KEYS=
VAULT_LOOKUP_KEY=
# Local key-encryption key for development only; production uses a KMS (VAULT_KEK_PROVIDER=kms)
VAULT_LOCAL_KEK=

# --- Data APIs (Phase 3) ---
# One api.data.gov key covers Congress.gov, Regulations.gov and OpenFEC: https://api.data.gov/signup/
DATA_GOV_API_KEY=
# https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=
# https://www.courtlistener.com/sign-in/
COURTLISTENER_API_TOKEN=

# --- Verification (Phase 1) ---
SHEERID_ACCESS_TOKEN=
SHEERID_PROGRAM_ID=

# --- 2FA (Phase 1) ---
# Email is the DEFAULT and FREE: the vault generates codes itself and only uses
# an email service for delivery. Without RESEND_API_KEY (development), codes are
# printed in the vault's terminal instead of emailed.
# Resend free plan: 3,000 emails/month, 100/day (https://resend.com/pricing).
# Requires a verified sending domain for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=

# SMS is OPTIONAL and only enabled when these are set. Intended for Twilio's
# FREE TRIAL only (verified numbers only, 30 days); we do not pay for Twilio.
# Test it with: pnpm --filter @demanity/vault twilio:trial
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Your own verified phone number, used only by the trial check script
TWILIO_TEST_TO=
