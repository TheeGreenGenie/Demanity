# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# --- Local databases (infra/docker-compose.yml) ---
ACTIVITY_DATABASE_URL=postgres://demanity:dev-only-activity@127.0.0.1:5434/demanity_activity
VAULT_DATABASE_URL=postgres://vault:dev-only-vault@127.0.0.1:5433/demanity_vault
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets: generate each with `node scripts/gen-secrets.mjs` (never reuse across environments) ---
# 32-byte base64 secret for hashing rate-limit keys (IPs are never stored raw)
RATE_LIMIT_SECRET=
# Shared token the API uses to call the vault (>= 32 chars)
VAULT_SERVICE_TOKEN=

# --- Passkeys (WebAuthn) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081

# --- Identity vault (apps/vault); internal only, never expose publicly ---
VAULT_URL=http://127.0.0.1:3100
VAULT_HOST=127.0.0.1
VAULT_PORT=3100
# "<version>:<32-byte base64>" list; highest version is current. Add a new version to rotate.
VAULT_TOKEN_KEYS=
VAULT_LOOKUP_KEY=
# Key-encryption key. Development: a local key. Production: AWS KMS (decided 2026-11-10), e.g.
#   VAULT_KEK_PROVIDER=kms  AWS_REGION=us-east-1  VAULT_KMS_KEY_ID=alias/demanity-vault
# AWS credentials come from the standard provider chain (IAM role), never from this file.
VAULT_KEK_PROVIDER=
AWS_REGION=
VAULT_KMS_KEY_ID=
VAULT_LOCAL_KEK=

# --- Data APIs (Phase 3) ---
# One api.data.gov key covers Congress.gov, Regulations.gov and OpenFEC: https://api.data.gov/signup/
# When set, the API syncs Congress.gov bills hourly. DEMO_KEY works for a quick try (heavily rate-limited).
DATA_GOV_API_KEY=
# Outbound budgets (docs/adr/0008-outbound-api-budgets.md). Leave empty for safe defaults:
# development syncs at most 25 bills per run from the last 3 days; Congress.gov
# requests are capped at 500/hour (its documented limit is 5,000/hour).
INGEST_MAX_BILLS_PER_RUN=
INGEST_LOOKBACK_DAYS=
CONGRESS_REQUESTS_PER_HOUR=
# https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=
# https://www.courtlistener.com/sign-in/
COURTLISTENER_API_TOKEN=

# --- Verification (Phase 1) ---
SHEERID_ACCESS_TOKEN=
SHEERID_PROGRAM_ID=

# --- 2FA (Phase 1) ---
# Email is the DEFAULT and FREE: the vault generates codes itself and only uses
# an email service for delivery. Without RESEND_API_KEY (development), codes are
# printed in the vault's terminal instead of emailed.
# Resend free plan: 3,000 emails/month, 100/day (https://resend.com/pricing).
# Requires a verified sending domain for EMAIL_FROM.
RESEND_API_KEY=
# "resend" sends real email (required in production). Outside production the default is
# "console": codes are printed by the vault, even if RESEND_API_KEY is set.
EMAIL_DELIVERY=
# Service-wide caps on codes sent (defaults stay inside Resend's free 100/day and a Twilio trial).
VAULT_EMAIL_PER_HOUR=
VAULT_EMAIL_PER_DAY=
VAULT_SMS_PER_HOUR=
VAULT_SMS_PER_DAY=
# Codes to any single phone number (defaults 3/hour, 6/day), against SMS pumping
VAULT_SMS_PER_NUMBER_PER_HOUR=
VAULT_SMS_PER_NUMBER_PER_DAY=
EMAIL_FROM=

# SMS is OPTIONAL and only enabled when these are set. Intended for Twilio's
# FREE TRIAL only (verified numbers only, 30 days); we do not pay for Twilio.
# Test it with: pnpm --filter @demanity/vault twilio:trial
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Your own verified phone number, used only by the trial check script
TWILIO_TEST_TO=

# --- Fact-checks (Phase 6) ---
# Optional AI first pass for the moderator panel (docs/adr/0009). Off unless
# FACT_CHECK_AI=anthropic AND a key are set. Budgeted: 5/minute, 20/hour, 100/day.
FACT_CHECK_AI=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
FACT_CHECK_MODEL=
# Flags from different members that open a review (default 5)
FACT_CHECK_FLAG_THRESHOLD=
# Contributor status is revoked when the contribution score is below this (default -3)
CONTRIBUTOR_MIN_SCORE=
